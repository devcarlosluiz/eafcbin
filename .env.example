# Copie para `.env` e preencha. O arquivo .env NÃO deve ir para o versionamento.

# --- Django ---------------------------------------------------------------
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Necessário se o painel ficar atrás de um proxy HTTPS. Ex.: https://painel.exemplo.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# --- API interna do painel Arena Virtual (ver api.MD) ---------------------
ARENA_HOST=https://sofifabrasil.arenavirtual.net
ARENA_LOGIN=seu_usuario
ARENA_SENHA=sua_senha

# Segundos entre requisições. O servidor limita a ~60 req/min — não baixe de 1.0.
ARENA_DELAY=1.2
ARENA_TIMEOUT=20

# Jogadores por página na tela. A API entrega 10 por página, então outros
# valores são montados juntando páginas dela: 16 custa 2–3 requisições por
# tela (múltiplos de 10 encaixam exato e custam menos).
ARENA_POR_PAGINA=16

# Busca por nome. "auto" detecta sozinho se a API aceita filtro no servidor;
# "off" força a varredura paginada; ou informe o parâmetro, se já souber
# (ex.: search).
ARENA_PARAM_BUSCA=auto

# Varredura: quantas páginas por lote e o teto por busca.
# Cada página custa ~1,2 s — 15 páginas ≈ 18 s de espera na tela.
ARENA_PAGINAS_POR_VARREDURA=15
ARENA_LIMITE_VARREDURA=300

# Segundos que uma página/ficha já consultada fica no cache em memória.
CACHE_TTL=600

# --- Acervo (banco) -------------------------------------------------------
# Vazio = SQLite em DJANGO_DATA_DIR/jogadores.sqlite3.
# Para outro banco: postgres://usuario:senha@host:5432/nome
DATABASE_URL=

# --- Agendador diário -----------------------------------------------------
# Horário local (America/Sao_Paulo) da rodada. A lista inteira leva ~40 min.
SYNC_HORARIO=03:30

# Minutos dedicados às fichas técnicas após a lista. Cada ficha é 1 requisição
# (~50/min), e são 19.415 jogadores: 120 min/dia cobrem a base em ~3 dias, em
# rodízio pelos verificados há mais tempo. Use 0 para não sincronizar fichas.
SYNC_MINUTOS_DETALHES=120

# Rodar uma sincronização assim que o agendador sobe, sem esperar o horário.
SYNC_AO_INICIAR=False

LOG_LEVEL=INFO
